{
  "name": "cyber-qingming",
  "private": true,
  "version": "1.2.0",
  "release": "R29",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "electron": "electron electron/main.cjs",
    "dist:win": "electron-builder --win portable --publish never",
    "atoms:rebuild": "node scripts/build-atomic-catalog.mjs && node scripts/build-scene-attribution.mjs && node scripts/annotate-atom-impl.mjs",
    "docs:gen": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check",
    "qa:gate": "node scripts/qa/package-gate.mjs",
    "qa:verify": "node scripts/qa/package-gate.mjs --verify-pack",
    "check:naming": "node scripts/check-naming.mjs"
  },
  "build": {
    "appId": "cyber.qingming.neonbianjing",
    "productName": "CyberQingming",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "CyberQingming-R29-${version}-${arch}.${ext}",
      "signAndEditExecutable": false,
      "sign": null
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^23.11.1",
    "source-map": "^0.7.6",
    "typescript": "^5.6.3",
    "vite": "^7.1.0",
    "vitest": "^3.0.5"
  }
}
